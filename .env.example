## Contact form email (Resend)
# Get an API key from Resend.
RESEND_API_KEY=

# Where the contact form delivers to.
CONTACT_TO=adrian@myrk.si

# Sender address. For production you should set this to a verified domain on Resend.
# Example: myrk.si <hello@myrk.si>
CONTACT_FROM=myrk.si <onboarding@resend.dev>

## Mail portal (IMAP/SMTP)
MAIL_PASSWORD=
PORTAL_PASSWORD=
# Optional: sign session cookies with a separate secret.
PORTAL_COOKIE_SECRET=

