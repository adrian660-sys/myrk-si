# Supabase (EU region: Frankfurt) — frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Admin email — used for client-side role detection.
# Server-side authorization is still enforced by RLS policies.
VITE_ADMIN_EMAIL=adrian@myrk.si

